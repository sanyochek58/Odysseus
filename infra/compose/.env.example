POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_TEST_USER_PASSWORD=change-me-local
# Порт postgres на хосте, если 5432 занят (тогда DB_URL сервиса тоже с этим портом)
#POSTGRES_PORT=5432
# Профиль app (make up PROFILE=app): тег образа и issuer, как его видит контейнер.
# Токен для сервиса в контейнере нужно получать по тому же хосту (host.docker.internal:8180), иначе iss не совпадёт.
#IMAGE_TAG=latest
#APP_KEYCLOAK_ISSUER_URI=http://host.docker.internal:8180/realms/odysseus
